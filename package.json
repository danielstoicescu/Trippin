{
  "name": "bcn-aventura",
  "version": "2.0.0",
  "private": true,
  "description": "Barcelona Aventura – ghid interactiv de vacanță (Mara, Anne & Daniel), găzduit pe Firebase Hosting cu Firestore.",
  "scripts": {
    "build": "node scripts/icons.mjs && node scripts/build.mjs",
    "watch": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
    "serve": "npx --yes serve public -l 5173",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans": "^5.3.1",
    "@material-symbols/svg-400": "^0.47.4",
    "leaflet": "^1.9.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^3.4.19"
  },
  "type": "module"
}
